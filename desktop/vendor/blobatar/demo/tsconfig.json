{
  "compilerOptions": {
    "lib": ["ESNext", "DOM"],
    "target": "ESNext",
    "module": "Preserve",
    "moduleDetection": "force",
    "jsx": "react-jsx",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "noUncheckedIndexedAccess": true,
    // The tuning grid reads the library from source, so a change to
    // `../src/shape.ts` reaches the grid on save — which is the whole point
    // of the grid.
    "paths": {
      "react": ["../../../node_modules/react/index.js"],
      "react/jsx-runtime": ["../../../node_modules/react/jsx-runtime.js"],
      "react-dom": ["../../../node_modules/react-dom/index.js"],
      "react-dom/client": ["../../../node_modules/react-dom/client.js"],
      "blobatar": ["../src/index.ts"],
      "blobatar/blob": ["../src/blob.ts"],
      "blobatar/uri": ["../src/uri.ts"],
      "blobatar/expression": ["../src/expression.ts"],
      "blobatar/react": ["../src/react.tsx"],
      "blobatar/motion.css": ["../src/motion.css"]
    }
  },
  "include": ["."]
}
