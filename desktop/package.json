{
  "name": "@blueberrycongee/wuu-desktop",
  "version": "2026.9.1",
  "description": "Desktop app for the Wuu AI coding agent",
  "author": "Andy wu <lpageo@163.com>",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "main": "out/main/index.js",
  "scripts": {
    "dev": "node scripts/dev.cjs",
    "dev:onboarding": "electron-vite --config dev/onboarding/electron.vite.config.ts --entry out-dev/onboarding/main/index.js --ignoreConfigWarning",
    "dev:remote": "node scripts/env-run.cjs VITE_ENABLE_REMOTE_CONTROL=true npm run dev",
    "dev:direct": "node scripts/env-run.cjs WUU_ENABLE_CUA_MAC=1 node scripts/dev.cjs",
    "lab:mascot": "vite dev/mascot --host 127.0.0.1 --port 5177",
    "build:cua-mac": "node scripts/build-cua-mac.cjs",
    "build:speech-mac": "node scripts/build-speech-mac.cjs",
    "icon:generate": "bun scripts/generate-icon.ts",
    "build:core": "node scripts/build-core.cjs",
    "build:core:win": "node scripts/build-core.cjs --platform=win32",
    "build": "node scripts/build-web.cjs && electron-vite build",
    "pack:mac": "npm run build:core && npm run build && CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --mac dir --publish=never --config.electronDist=node_modules/electron/dist",
    "dist:mac": "npm run build:core && npm run build && CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --mac dmg zip --publish=never --config.electronDist=node_modules/electron/dist",
    "pack:win": "npm run build:core:win && npm run build && electron-builder --win dir --publish=never",
    "dist:win": "npm run build:core:win && npm run build && electron-builder --win nsis zip --publish=never",
    "release:desktop": "npm run dist:mac",
    "test": "npm run test:dev-launcher && npm run test:unit",
    "test:dev-launcher": "node scripts/test-dev-launcher.cjs",
    "test:unit": "vitest run --exclude=src/main/gitService.test.ts && vitest run src/main/gitService.test.ts --maxWorkers=1 --minWorkers=1 --testTimeout=15000",
    "test:cua-mac": "node scripts/test-cua-mac.cjs",
    "test:watch": "vitest",
    "test:e2e:permission-mode": "npm run build && electron scripts/permission-mode-e2e.cjs",
    "test:e2e:streaming": "npm run build && electron scripts/streaming-e2e.cjs",
    "test:e2e:process-handoff": "npm run build && electron scripts/process-handoff-e2e.cjs",
    "test:e2e:window-resize": "npm run build && electron scripts/window-resize-perf-e2e.cjs",
    "test:e2e:document-composer-width": "npm run build && electron scripts/document-composer-width-e2e.cjs",
    "test:e2e:session-composer-width": "npm run build && electron scripts/session-composer-width-e2e.cjs",
    "test:e2e:sidebar-touch": "npm run build && electron scripts/sidebar-touch-e2e.cjs",
    "test:e2e:settings-sidebar-hit": "npm run build && electron scripts/settings-sidebar-hit-e2e.cjs",
    "test:e2e:browser-pip": "node scripts/browser-pip-e2e.cjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^9.0.0",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@pierre/trees": "^1.0.0-beta.4",
    "@vvo/tzdb": "^6.198.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "blobatar": "file:vendor/blobatar",
    "cordis": "4.0.0-rc.8",
    "highlight.js": "^11.11.1",
    "lucide-react": "^0.562.0",
    "mermaid": "^11.15.0",
    "monaco-editor": "^0.53.0",
    "node-pty": "^1.1.0",
    "pdfjs-dist": "5.4.624",
    "qrcode": "^1.5.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.1.0",
    "rehype-raw": "^7.0.0",
    "remark-gfm": "^4.0.1"
  },
  "build": {
    "appId": "com.blueberrycongee.wuu",
    "productName": "wuu",
    "artifactName": "${productName}-${version}-${os}-${arch}.${ext}",
    "directories": {
      "output": "release"
    },
    "afterPack": "scripts/after-pack.cjs",
    "files": [
      "out/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "build/bin",
        "to": "bin",
        "filter": [
          "wuu-core",
          "wuu-core.exe",
          "wuu-*-plugin",
          "wuu-*-plugin.exe"
        ]
      },
      {
        "from": "build/mobile-web",
        "to": "mobile-web"
      }
    ],
    "asarUnpack": [
      "node_modules/node-pty/**/*"
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "icon": "build/icon.icns",
      "target": [
        "dmg",
        "zip"
      ]
    },
    "dmg": {
      "artifactName": "${productName}-${version}-${os}-${arch}.${ext}"
    },
    "win": {
      "icon": "build/icon.ico",
      "target": [
        "nsis",
        "zip"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "${productName}-${version}-${os}-${arch}-setup.${ext}"
    }
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^44.1.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "jsdom": "^25.0.0",
    "typescript": "^7.0.2",
    "vite": "^7.3.6",
    "vitest": "^3.2.7"
  }
}
