{
  "name": "@wuu/plugin-sdk",
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "description": "Wuu Plugin SDK \u2014 types and helpers for building Wuu plugins",
  "scripts": {
    "build": "tsc",
    "typecheck": "npm run build && tsc --project tsconfig.preview.json",
    "test": "npm run build && node --test dist/*.test.js test/*.test.mjs",
    "prepack": "npm run build",
    "test:author": "node test/author-loop.mjs"
  },
  "devDependencies": {
    "@types/node": "22.10.0",
    "@types/react-dom": "19.2.3",
    "@types/react": "19.2.15"
  },
  "files": [
    "dist/index.js",
    "dist/index.d.ts",
    "dist/theme-contract.generated.js",
    "dist/theme-contract.generated.d.ts",
    "dist/bundle-contract.js",
    "dist/bundle-contract.d.ts",
    "dist/model.js",
    "dist/model.d.ts",
    "dist/process.js",
    "dist/process.d.ts",
    "dist/driver.js",
    "dist/driver.d.ts",
    "dist/persistence.js",
    "dist/persistence.d.ts",
    "dist/providers.js",
    "dist/providers.d.ts",
    "dist/coordination.js",
    "dist/coordination.d.ts",
    "dist/tool-service.js",
    "dist/tool-service.d.ts",
    "dist/session-service.js",
    "dist/session-service.d.ts",
    "dist/ui-composer.js",
    "dist/ui-composer.d.ts",
    "dist/prompt-service.js",
    "dist/prompt-service.d.ts",
    "dist/title-service.js",
    "dist/title-service.d.ts",
    "dist/compaction-service.js",
    "dist/compaction-service.d.ts",
    "dist/application-settings.js",
    "dist/application-settings.d.ts",
    "dist/ui-preview.js",
    "dist/ui-preview.d.ts",
    "dist/ui-settings-controls.js",
    "dist/ui-settings-controls.d.ts",
    "dist/ui-navigation.js",
    "dist/ui-navigation.d.ts",
    "dist/ui-conversation-actions.js",
    "dist/ui-conversation-actions.d.ts",
    "dist/ui-preview-content.js",
    "dist/ui-preview-content.d.ts",
    "dist/ui-catalog.js",
    "dist/ui-catalog.d.ts",
    "dist/ui-conversation.js",
    "dist/ui-conversation.d.ts",
    "dist/ui-composer-presentation.js",
    "dist/ui-composer-presentation.d.ts",
    "dist/ui-composer-runtime.js",
    "dist/ui-composer-runtime.d.ts",
    "dist/ui-environment.js",
    "dist/ui-environment.d.ts",
    "dist/ui-submission.js",
    "dist/ui-submission.d.ts",
    "dist/ui-search.js",
    "dist/ui-search.d.ts",
    "dist/ui-terminals.js",
    "dist/ui-terminals.d.ts",
    "dist/ui-browser.js",
    "dist/ui-browser.d.ts",
    "dist/ui-desktop.js",
    "dist/ui-desktop.d.ts",
    "dist/ui-projects.js",
    "dist/ui-projects.d.ts",
    "dist/ui-file-selection.js",
    "dist/ui-file-selection.d.ts",
    "dist/ui-side-conversation.js",
    "dist/ui-side-conversation.d.ts",
    "dist/ui-web-workspace.js",
    "dist/ui-web-workspace.d.ts",
    "dist/ui-artifacts.js",
    "dist/ui-artifacts.d.ts",
    "dist/ui-onboarding.js",
    "dist/ui-onboarding.d.ts",
    "dist/ui.js",
    "dist/ui.d.ts",
    "bin/preview.mjs",
    "preview/*.mjs",
    "preview/*.ts",
    "preview/*.tsx"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./ui": {
      "types": "./dist/ui.d.ts",
      "import": "./dist/ui.js"
    }
  },
  "dependencies": {
    "esbuild": "0.25.12",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "typescript": "5.9.3"
  },
  "bin": {
    "wuu-plugin-preview": "./bin/preview.mjs"
  },
  "peerDependencies": {
    "@types/react": "^19.2.15"
  }
}
