{
  "name": "@wuu/plugin-sdk",
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "description": "Wuu Plugin SDK \u2014 types and helpers for building Wuu plugins",
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit && tsc --project tsconfig.preview.json",
    "test": "npm run build && node --test dist/*.test.js test/*.test.mjs",
    "prepack": "npm run build",
    "test:author": "node test/author-loop.mjs"
  },
  "devDependencies": {
    "@types/node": "22.10.0",
    "@types/react-dom": "19.2.3",
    "@types/react": "19.2.15"
  },
  "files": [
    "dist/index.js",
    "dist/index.d.ts",
    "dist/theme-contract.generated.js",
    "dist/theme-contract.generated.d.ts",
    "dist/bundle-contract.js",
    "dist/bundle-contract.d.ts",
    "dist/model.js",
    "dist/model.d.ts",
    "dist/process.js",
    "dist/process.d.ts",
    "dist/driver.js",
    "dist/driver.d.ts",
    "dist/persistence.js",
    "dist/persistence.d.ts",
    "dist/ui.js",
    "dist/ui.d.ts",
    "bin/preview.mjs",
    "preview/*.mjs",
    "preview/*.ts",
    "preview/*.tsx"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./ui": {
      "types": "./dist/ui.d.ts",
      "import": "./dist/ui.js"
    }
  },
  "dependencies": {
    "esbuild": "0.25.12",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "typescript": "5.9.3"
  },
  "bin": {
    "wuu-plugin-preview": "./bin/preview.mjs"
  },
  "peerDependencies": {
    "@types/react": "^19.2.15"
  }
}
