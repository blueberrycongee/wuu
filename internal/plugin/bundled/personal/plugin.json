      }
    ],
    "settingsPages": [
      {
        "id": "personal-preferences",
        "title": "twin",
        "view": "personal.preferences",
        "icon": "mascot",
        "order": 41
      }
    ]
  },
  "interface": {
    "displayName": "twin",
