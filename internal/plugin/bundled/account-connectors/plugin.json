{
  "schemaVersion": 1,
  "id": "account-connectors",
  "name": "Account Connectors",
  "description": "Connect your accounts through official MCP services that need no extra setup.",
  "icon": { "path": "icon.webp" },
  "version": "0.3.0",
  "defaultEnabled": true,
  "author": { "name": "Wuu" },
  "mcp_servers": {
    "notion": {
      "url": "https://mcp.notion.com/mcp",
      "transport": "http",
      "enabled": false,
      "connector": {
        "title": "Notion",
        "description": "Search and edit pages in your Notion workspace.",
        "documentation_url": "https://developers.notion.com/guides/mcp/build-mcp-client",
        "icon": { "path": "assets/notion.svg" },
        "identity_probe": {
          "tool": "notion-get-self",
          "arguments": {},
          "result": "single_text_json",
          "account": { "id": "/user/id", "label": "/user/name", "email": "/user/email", "kind": "/user/type" },
          "workspace": { "id": "/workspace/id", "label": "/workspace/name" }
        }
      },
      "tool_overrides": { "notion-get-self": { "read_only": true } }
    },
    "linear": {
      "url": "https://mcp.linear.app/mcp",
      "transport": "http",
      "enabled": false,
      "connector": {
        "title": "Linear",
        "description": "Find and update issues, projects, and comments in Linear.",
        "documentation_url": "https://linear.app/docs/mcp",
        "icon": { "light": "assets/linear-light.svg", "dark": "assets/linear-dark.svg" }
      }
    },
    "atlassian": {
      "url": "https://mcp.atlassian.com/v2/mcp",
      "transport": "http",
      "enabled": false,
      "connector": {
        "title": "Atlassian",
        "description": "Search and update Jira issues and Confluence pages.",
        "documentation_url": "https://support.atlassian.com/atlassian-rovo-mcp-server/docs/getting-started-with-the-atlassian-remote-mcp-server/",
        "icon": { "light": "assets/atlassian-light.svg", "dark": "assets/atlassian-dark.svg" }
      }
    },
    "sentry": {
      "url": "https://mcp.sentry.dev/mcp",
      "transport": "http",
      "enabled": false,
      "connector": {
        "title": "Sentry",
        "description": "Investigate errors and performance issues in Sentry.",
        "documentation_url": "https://mcp.sentry.dev/",
        "icon": { "light": "assets/sentry-light.svg", "dark": "assets/sentry-dark.svg" }
      }
    }
  },
  "interface": {
    "displayName": "Account Connectors",
    "shortDescription": "Connect your accounts with one click.",
    "developerName": "Wuu",
    "category": "Productivity"
  }
}
