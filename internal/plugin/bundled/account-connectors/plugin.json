{
  "schemaVersion": 1,
  "id": "account-connectors",
  "name": "Account Connectors",
  "description": "Connect your accounts through official MCP services that need no extra setup.",
  "icon": "plug",
  "version": "0.2.0",
  "defaultEnabled": true,
  "author": { "name": "Wuu" },
  "mcp_servers": {
    "notion": {
      "url": "https://mcp.notion.com/mcp",
      "transport": "http",
      "enabled": false,
      "connector": {
        "title": "Notion",
        "description": "Search and edit pages in your Notion workspace.",
        "documentation_url": "https://developers.notion.com/guides/mcp/build-mcp-client",
        "icon": { "path": "assets/notion.svg" },
        "identity_probe": {
          "tool": "notion-get-self",
          "arguments": {},
          "result": "single_text_json",
          "account": { "id": "/user/id", "label": "/user/name", "email": "/user/email", "kind": "/user/type" },
          "workspace": { "id": "/workspace/id", "label": "/workspace/name" }
        }
      },
      "tool_overrides": { "notion-get-self": { "read_only": true } }
    }
  },
  "interface": {
    "displayName": "Account Connectors",
    "shortDescription": "Connect your accounts with one click.",
    "developerName": "Wuu",
    "category": "Productivity"
  }
}
