{
  "schema_version": 1,
  "id": "developer-loop-example",
  "name": "Developer Loop Example",
  "version": "1.0.0",
  "description": "Buildable runtime and desktop entries for the local plugin developer loop.",
  "icon": "check-circle",
  "runtime": {
    "protocol": "wuu-plugin-v1",
    "command": "node",
    "args": ["dist/runtime.js"]
  },
  "desktop": {
    "entry": "dist/renderer.js"
  },
  "contributes": {
    "themes": [
      {
        "id": "developer-focus",
        "name": "Developer Focus",
        "base": "dark",
        "tokens": {
          "--wuu-paper": "#111827",
          "--wuu-ink": "#f9fafb",
          "--wuu-ink-soft": "#9ca3af",
          "--wuu-hairline": "#374151",
          "--wuu-surface-muted": "#1f2937",
          "--wuu-accent": "#60a5fa",
          "--wuu-accent-press": "#3b82f6"
        },
        "syntax": {
          "--hljs-keyword": "#c084fc",
          "--hljs-function": "#67e8f9",
          "--hljs-string": "#86efac",
          "--hljs-number": "#fbbf24",
          "--hljs-comment": "#9ca3af"
        }
      }
    ],
    "settings": {
      "enabled": {
        "type": "boolean",
        "title": "Enable counter",
        "description": "Allow the acceptance view to update its stored counter.",
        "default": true,
        "scope": "user",
        "apply": "live"
      },
      "label": {
        "type": "string",
        "title": "Counter label",
        "default": "Accepted runs",
        "scope": "workspace",
        "apply": "live"
      },
      "step": {
        "type": "number",
        "title": "Counter step",
        "default": 1,
        "scope": "workspace",
        "apply": "live"
      },
      "density": {
        "type": "enum",
        "title": "View density",
        "default": "comfortable",
        "enum": ["compact", "comfortable"],
        "scope": "user",
        "apply": "live"
      }
    },
    "presenters": [
      { "id": "assistant-message", "target": "conversation.item", "mode": "wrap" },
      { "id": "composer", "target": "conversation.composer", "mode": "wrap" },
      { "id": "primary-navigation", "target": "navigation.primary", "mode": "wrap" },
      { "id": "markdown-preview", "target": "content.preview", "mode": "wrap" },
      { "id": "application-status", "target": "app.status", "mode": "wrap" },
      { "id": "conversation-header", "target": "header.conversation", "mode": "wrap" }
    ],

    "workspaceTools": [
      {
        "id": "acceptance-workspace-tool",
        "view": "acceptance-counter",
        "title": "Acceptance",
        "description": "Show the acceptance counter beside the workspace.",
        "icon": "check-circle",
        "order": 100
      }
    ],
    "settingsPages": [
      {
        "id": "acceptance-details",
        "view": "acceptance-counter",
        "title": "Developer Loop Details",
        "description": "Inspect the same plugin view inside Settings.",
        "icon": "check-circle",
        "order": 110
      }
    ]
  }
}
