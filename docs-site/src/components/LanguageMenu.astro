---
import manifest from "../../../docs/site.json"

const locales = [
  { locale: "zh-cn", label: "简体中文" },
  { locale: "en", label: "English" },
] as const
const pathSegments = Astro.url.pathname.split("/")
const currentLocale = locales.find(({ locale }) => pathSegments.includes(locale))?.locale ?? "zh-cn"
const currentLabel = locales.find(({ locale }) => locale === currentLocale)!.label
const defaultLocale =
  manifest.locales[manifest.site.default_locale as keyof typeof manifest.locales].root
const siteBase = import.meta.env.BASE_URL
const routesByLocale = Object.fromEntries(
  Object.values(manifest.locales).map((config) => [
    config.root,
    new Set(
      config.navigation.flatMap((group) =>
        group.pages.map((page) =>
          page.replace(`${config.root}/`, "").replace(/\.md$/, "").replace(/\/index$/, ""),
        ),
      ),
    ),
  ]),
)

function localizedHref(locale: string) {
  const segments = Astro.url.pathname.split("/")
  const localeIndex = segments.findIndex((segment) => segment === currentLocale)
  if (localeIndex < 0) return `${siteBase}${locale}/`
  const route = segments.slice(localeIndex + 1).filter(Boolean).join("/")
  const ownRoutes = routesByLocale[locale] ?? new Set<string>()
  const fallbackRoutes = locale === defaultLocale ? new Set<string>() : routesByLocale[defaultLocale]
  if (route && !ownRoutes.has(route) && !fallbackRoutes?.has(route)) {
    return `${segments.slice(0, localeIndex).concat(locale, "").join("/")}`
  }
  segments[localeIndex] = locale
  return `${segments.join("/")}${Astro.url.search}${Astro.url.hash}`
}
---

<wuu-language-menu>
  <button class="header-menu-trigger" type="button" aria-haspopup="menu" aria-expanded="false">
    <svg aria-hidden="true" viewBox="0 0 24 24" width="16" height="16">
      <path d="M5 4h7M8.5 2v2m-5 4h10m-2 0a12 12 0 0 1-7 8m2-8a12 12 0 0 0 7 8m1.5 4 3.5-8 3.5 8m-5.8-2h4.6" />
    </svg>
    <span>{currentLabel}</span>
    <svg class="header-menu-caret" aria-hidden="true" viewBox="0 0 16 16" width="14" height="14">
      <path d="m4 6 4 4 4-4" />
    </svg>
  </button>

  <div class="header-menu-panel" role="menu" hidden>
    {
      locales.map(({ locale, label }) => {
        const selected = locale === currentLocale
        return (
          <a
            href={localizedHref(locale)}
            role="menuitemradio"
            aria-checked={selected ? "true" : "false"}
            tabindex="-1"
          >
            <svg class="header-menu-check" aria-hidden="true" viewBox="0 0 16 16" width="14" height="14">
              {selected && <path d="m3 8 3 3 7-7" />}
            </svg>
            <span>{label}</span>
          </a>
        )
      })
    }
  </div>
</wuu-language-menu>

<script>
  class WuuLanguageMenu extends HTMLElement {
    button = this.querySelector<HTMLButtonElement>(".header-menu-trigger")
    panel = this.querySelector<HTMLElement>(".header-menu-panel")
    items = [...this.querySelectorAll<HTMLAnchorElement>("[role='menuitemradio']")]

    connectedCallback() {
      this.button?.addEventListener("click", this.onButtonClick)
      this.button?.addEventListener("keydown", this.onButtonKeyDown)
      this.panel?.addEventListener("keydown", this.onPanelKeyDown)
      this.items.forEach((item) => item.addEventListener("click", this.close))
      document.addEventListener("pointerdown", this.onOutsidePointerDown)
    }

    disconnectedCallback() {
      document.removeEventListener("pointerdown", this.onOutsidePointerDown)
    }

    setOpen = (open: boolean) => {
      if (!this.button || !this.panel) return
      this.button.setAttribute("aria-expanded", String(open))
      this.panel.hidden = !open
    }

    close = () => this.setOpen(false)

    focusItem(index: number) {
      this.items.at(index)?.focus()
    }

    onButtonClick = () => {
      this.setOpen(this.button?.getAttribute("aria-expanded") !== "true")
    }

    onButtonKeyDown = (event: KeyboardEvent) => {
      if (event.key !== "ArrowDown" && event.key !== "ArrowUp") return
      event.preventDefault()
      this.setOpen(true)
      this.focusItem(event.key === "ArrowDown" ? 0 : -1)
    }

    onPanelKeyDown = (event: KeyboardEvent) => {
      const current = this.items.indexOf(document.activeElement as HTMLAnchorElement)
      let target: number | undefined
      if (event.key === "ArrowDown") target = (current + 1) % this.items.length
      if (event.key === "ArrowUp") target = (current - 1 + this.items.length) % this.items.length
      if (event.key === "Home") target = 0
      if (event.key === "End") target = -1
      if (target !== undefined) {
        event.preventDefault()
        this.focusItem(target)
      } else if (event.key === "Escape") {
        event.preventDefault()
        this.close()
        this.button?.focus()
      }
    }

    onOutsidePointerDown = (event: PointerEvent) => {
      if (!this.contains(event.target as Node)) this.close()
    }
  }

  if (!customElements.get("wuu-language-menu")) {
    customElements.define("wuu-language-menu", WuuLanguageMenu)
  }
</script>
