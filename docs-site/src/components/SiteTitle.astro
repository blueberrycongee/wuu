---
const chinese = Astro.url.pathname.split("/").includes("zh-cn")
const base = import.meta.env.BASE_URL.replace(/\/$/, "")
const navLinks = chinese
  ? [
      ["产品", `${base}/zh/`],
      ["博客", `${base}/zh-blog/`],
      ["下载", "https://github.com/blueberrycongee/wuu/releases/latest"],
    ]
  : [
      ["Product", `${base}/`],
      ["Blog", `${base}/blog/`],
      ["Download", "https://github.com/blueberrycongee/wuu/releases/latest"],
    ]
---
<div class="docs-brand">
  <a class="site-title" href={`${base}/${chinese ? "zh/" : ""}`} aria-label={chinese ? "Wuu 官网" : "Wuu home"}>
    <img src={`${base}/site-assets/brand/wuu.svg`} width="36" height="36" alt="" />
    <span translate="no">wuu</span>
  </a>
  <a class="docs-brand-section" href={`${base}/${chinese ? "zh-cn" : "en"}/`}>{chinese ? "文档" : "Docs"}</a>
  <nav class="docs-topnav" aria-label={chinese ? "站点导航" : "Site"}>
    {
      navLinks.map(([label, href]) => (
        <a href={href} rel={href.startsWith("http") ? "noreferrer" : undefined}>
          {label}
        </a>
      ))
    }
  </nav>
</div>
