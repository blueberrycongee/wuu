---
const chinese = Astro.url.pathname.split("/").includes("zh-cn")
const base = import.meta.env.BASE_URL.replace(/\/$/, "")
const navLinks = chinese
  ? [
      ["产品", `${base}/zh/`],
      ["博客", `${base}/zh-blog/`],
      ["下载", "https://github.com/blueberrycongee/wuu/releases/latest"],
    ]
  : [
      ["Product", `${base}/`],
      ["Blog", `${base}/blog/`],
      ["Download", "https://github.com/blueberrycongee/wuu/releases/latest"],
    ]
---
<div class="docs-brand">
  <a class="site-title" href={`${base}/${chinese ? "zh/" : ""}`} aria-label={chinese ? "Wuu 官网" : "Wuu home"}>
    <img
      class="site-mark"
      src={`${base}/site-assets/app-icon.png`}
      width="32"
      height="32"
      alt=""
    />
    {/* Product wordmark from desktop/src/renderer/SidebarBrand.tsx. */}
    <svg class="site-wordmark" viewBox="0 0 3413 1020" aria-hidden="true">
      <path
        fill="currentColor"
        d="M584 240L584 628.27C584 751.17 529.44 809 413.5 809C297.56 809 243 751.17 243 628.27L243 0L0 0L0 598.65C0 885.17 127.2 1020 397.5 1020C527.19 1020 623.94 988.96 689.5 925.02C755.06 988.96 851.81 1020 981.5 1020C1251.8 1020 1379 885.17 1379 598.65L1379 0L1136 0L1136 628.27C1136 751.17 1081.44 809 965.5 809C849.56 809 795 751.17 795 628.27L795 240L584 240ZM1752 0L1752 593.82C1752 740.14 1816.96 809 1955 809C2093.04 809 2158 740.14 2158 593.82L2158 0L2401 0L2401 1000L2158 1000L2158 989.46C2100.82 1009.93 2033.25 1020 1955 1020C1651.72 1020 1509 868.72 1509 547.24L1509 0L1752 0ZM2764 593.82L2764 0L2521 0L2521 547.24C2521 868.72 2663.72 1020 2967 1020C3045.25 1020 3112.82 1009.93 3170 989.46L3170 1000L3413 1000L3413 0L3170 0L3170 593.82C3170 740.14 3105.04 809 2967 809C2828.96 809 2764 740.14 2764 593.82Z"
      />
    </svg>
  </a>
  <a class="docs-brand-section" href={`${base}/${chinese ? "zh-cn" : "en"}/`}>{chinese ? "文档" : "Docs"}</a>
  <nav class="docs-topnav" aria-label={chinese ? "站点导航" : "Site"}>
    {
      navLinks.map(([label, href]) => (
        <a href={href} rel={href.startsWith("http") ? "noreferrer" : undefined}>
          {label}
        </a>
      ))
    }
  </nav>
</div>
